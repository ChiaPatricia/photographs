{
  "name": "jia-photographs",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Jia — a photography archive built from a Google Drive folder.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-drive.mjs",
    "photos": "node scripts/build-photos.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "content": "npm run photos && npm run fonts",
    "dev": "astro dev",
    "build": "npm run content && astro build",
    "build:site": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "6.4.8"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "exifr": "7.1.3",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  }
}
