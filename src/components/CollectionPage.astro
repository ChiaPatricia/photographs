---
import Base from '../layouts/Base.astro';
import T from './T.astro';
import Photo from './Photo.astro';
import Viewer from './Viewer.astro';
import Sentence from './Sentence.astro';
import {
  altText,
  collectionHref,
  collections,
  jpeg,
  line,
  photoCount,
  plateHref,
  plateLabel,
  media,
  span,
  stampText,
  technical,
  type Collection,
} from '../lib/archive';
import { compose, sizesFor } from '../lib/compose';
import { time, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  collection: Collection;
}

const { lang, collection: c } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const spreads = compose(c);
const next = collections[c.number % collections.length];
const plate = (p: (typeof c.photos)[number]) => ({ en: plateHref('en', c, p), zh: plateHref('zh', c, p) });

const data = {
  collection: { slug: c.slug, number: c.number, behaviour: c.behaviour, href: { en: collectionHref('en', c), zh: collectionHref('zh', c) } },
  photos: c.photos.map((p) => ({
    id: p.id,
    hash: p.hash,
    w: p.w,
    h: p.h,
    r: p.ratio,
    widths: p.widths,
    color: p.color,
    lqip: p.lqip,
    alt: altText(c, p),
    line: line(p),
    tech: technical(p),
    note: p.note,
    n: plateLabel(c, p),
    stamp: stampText(p),
    href: plate(p),
  })),
};

const dates = span(c);
const thumb = (p: (typeof c.photos)[number]) => p.widths.find((w) => w >= 480) ?? p.widths.at(-1)!;
---

<Base
  lang={lang}
  page="collection"
  title={{ en: `${c.word.en} — Jia`, zh: `${c.word.zh} — Jia` }}
  description={c.sentence}
  path={{ en: collectionHref('en', c), zh: collectionHref('zh', c) }}
  tint={c.tint}
  image={jpeg(c.photos[0], 1200)}
  data={data}
  current={c.slug}
  color={c.color ?? undefined}
>
  <section class="opening" aria-labelledby="title">
    <span class="num">{pad(c.number)}</span>
    <h1 id="title">
      <span class="w" data-l="en" lang="en">{c.word.en}</span>
      <span class="w" data-l="zh" lang="zh-Hans">{c.word.zh}</span>
      <span class="z" data-l="en" lang="zh-Hans">{c.word.zh}</span>
      <span class="z" data-l="zh" lang="en">{c.word.en}</span>
      {c.emoji && <span class="sticker e" aria-hidden="true">{c.emoji}</span>}
    </h1>
    <p class="meta small">
      <span><T t={photoCount(c)} /></span>
      {dates && <span><T t={dates} /></span>}
      {import.meta.env.DEV && c.status !== 'final' && <span class="draft"><T t={ui.draft} /></span>}
    </p>
  </section>

  <div class="seq" data-behaviour={c.behaviour ?? undefined}>
    {
      spreads.map((s, k) => {
        if (s.kind === 'sentence')
          return (
            <div class={`spread sentence space-${s.space}`}>
              <aside class="fact reveal">
                <span class="label">
                  <span class="e">{c.emoji ?? '✦'}</span>
                  <T t={ui.fact} />
                </span>
                <p class="serif">
                  <Sentence t={c.sentence!} />
                </p>
              </aside>
            </div>
          );
        if (s.kind === 'single')
          return (
            <div class:list={['spread single', `size-${s.size}`, `align-${s.align}`, `space-${s.space}`, s.photo.ratio < 1 && 'is-portrait']}>
              <Photo
                photo={s.photo}
                collection={c}
                lang={lang}
                id={s.photo.id}
                sizes={sizesFor(s.size, s.photo.ratio)}
                href={plate(s.photo)}
                eager={k === 0}
                priority={k === 0}
                print={s.size === 'small'}
              />
            </div>
          );
        const [a, b] = s.photos;
        const stack = a.ratio + b.ratio > 1.6;
        return (
          <div
            class:list={['spread', `pair-${s.style}`, `space-${s.space}`, stack && 'is-stack']}
            style={`--r1:${a.ratio};--r2:${b.ratio}`}
          >
            <Photo
              photo={a}
              collection={c}
              lang={lang}
              id={a.id}
              sizes={s.style === 'even' ? sizesFor('pair-even', a.ratio, b.ratio) : sizesFor('pair-offset-a', a.ratio)}
              href={plate(a)}
              eager={k === 0}
            />
            <Photo
              photo={b}
              collection={c}
              lang={lang}
              id={b.id}
              sizes={s.style === 'even' ? sizesFor('pair-even', b.ratio, a.ratio) : sizesFor('pair-offset-b', b.ratio)}
              href={plate(b)}
              delay={160}
              print={s.style === 'offset'}
            />
          </div>
        );
      })
    }
  </div>

  <section class="roll" aria-labelledby="roll-title" data-color={c.color ?? undefined}>
    <div class="roll-head">
      <h2 id="roll-title" class="pill"><span class="e">📸</span><T t={ui.roll} /> · {c.photos.length}</h2>
    </div>
    <ol>
      {
        c.photos.map((p) => (
          <li data-id={p.id}>
            <a href={plate(p)[lang]} data-href-en={plate(p).en} data-href-zh={plate(p).zh} data-open={p.id} style={`--c:${p.color}`} data-cursor="open">
              <picture>
                <source type="image/avif" srcset={media(p, thumb(p), 'avif')} />
                <img src={media(p, Math.min(thumb(p), 1200), 'jpg')} alt="" width={p.w} height={p.h} loading="lazy" decoding="async" />
              </picture>
              {stampText(p) && <span class="stamp" aria-hidden="true">{stampText(p)}</span>}
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <nav class="next small" aria-label="Next" data-color={next.color ?? undefined}>
    <a class="to" href={collectionHref(lang, next)} data-href-en={collectionHref('en', next)} data-href-zh={collectionHref('zh', next)}>
      <span class="muted">
        <T t={ui.next} /> · {pad(next.number)}
      </span>
      <span class="w serif">
        <T t={next.word} />
        {next.emoji && <span class="sticker e" aria-hidden="true">{next.emoji}</span>}
      </span>
    </a>
  </nav>

  <Viewer slot="after" />
</Base>
