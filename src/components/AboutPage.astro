---
// Kept to a photograph and a few facts. The facts are read from the archive itself.
import Base from '../layouts/Base.astro';
import T from './T.astro';
import Photo from './Photo.astro';
import { aboutHref, archive, facts, plateHref, resolve, site } from '../lib/archive';
import { count, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = facts();
const pic = resolve(archive.about.photo);
const fragment = archive.about.fragment?.en || archive.about.fragment?.zh ? archive.about.fragment : null;
const when =
  f.first && f.last
    ? f.days > 1
      ? { en: `${f.first.en} – ${f.last.en}`, zh: `${f.first.zh}至${f.last.zh}` }
      : f.first
    : null;
---

<Base lang={lang} page="about" title={{ en: 'About — Jia', zh: '关于 — Jia' }} path={{ en: aboutHref('en'), zh: aboutHref('zh') }}>
  <div class="page">
    {
      pic && (
        <Photo
          photo={pic.photo}
          collection={pic.collection}
          lang={lang}
          sizes="(max-width: 699px) 62vw, 22vw"
          href={{ en: plateHref('en', pic.collection, pic.photo), zh: plateHref('zh', pic.collection, pic.photo) }}
          eager
        />
      )
    }
    <div class="text">
      <h1>{site.name.en}</h1>
      {
        fragment && (
          <p class="fragment serif">
            <T t={fragment} />
          </p>
        )
      }
      <dl class="facts small">
        <dt><T t={{ en: 'Photographs', zh: '照片' }} /></dt>
        <dd>
          <T t={count(f.total)} />{when && <>, <T t={when} /></>}
        </dd>
        <dt><T t={{ en: 'Cameras', zh: '相机' }} /></dt>
        <dd>{f.cameras.join(', ')}</dd>
        <dt><T t={{ en: 'Lens', zh: '镜头' }} /></dt>
        <dd>{f.lenses.join(', ')}</dd>
        <dt><T t={{ en: 'Type', zh: '字体' }} /></dt>
        <dd><T t={ui.set} /></dd>
        <dt><T t={{ en: 'Keys', zh: '按键' }} /></dt>
        <dd><T t={ui.keys} /></dd>
        {
          site.contact?.email && (
            <>
              <dt><T t={{ en: 'Write', zh: '联系' }} /></dt>
              <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
            </>
          )
        }
        {
          site.contact?.instagram && (
            <>
              <dt>Instagram</dt>
              <dd><a href={`https://www.instagram.com/${site.contact.instagram.replace(/^@/, '')}/`}>{site.contact.instagram}</a></dd>
            </>
          )
        }
      </dl>
    </div>
  </div>
</Base>
