---
// A photograph and a name. Nothing to read unless Jia adds a line in content/site.yaml.
import Base from '../layouts/Base.astro';
import T from './T.astro';
import Photo from './Photo.astro';
import { aboutHref, archive, plateHref, resolve, site } from '../lib/archive';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pic = resolve(archive.about.photo);
const fragment = archive.about.fragment?.en || archive.about.fragment?.zh ? archive.about.fragment : null;
---

<Base lang={lang} page="about" title={{ en: 'About — Jia', zh: '关于 — Jia' }} path={{ en: aboutHref('en'), zh: aboutHref('zh') }}>
  <div class="page">
    {
      pic && (
        <Photo
          photo={pic.photo}
          collection={pic.collection}
          lang={lang}
          sizes="(max-width: 699px) 64vw, 30vw"
          href={{ en: plateHref('en', pic.collection, pic.photo), zh: plateHref('zh', pic.collection, pic.photo) }}
          eager
          print
        />
      )
    }
    <div class="text">
      <h1>{site.name.en}</h1>
      {
        fragment && (
          <p class="fragment serif">
            <T t={fragment} />
          </p>
        )
      }
      <p class="links">
        <a class="pill" href="https://luckyjiaxu.com/" data-href-en="https://luckyjiaxu.com/" data-href-zh="https://luckyjiaxu.com/zh/">
          <span class="e">🏡</span>
          <T t={ui.home} />
        </a>
        {site.contact?.email && (
          <a class="pill" href={`mailto:${site.contact.email}`}>
            <span class="e">✉️</span>
            {site.contact.email}
          </a>
        )}
        {site.contact?.instagram && (
          <a class="pill" href={`https://www.instagram.com/${site.contact.instagram.replace(/^@/, '')}/`}>
            <span class="e">📷</span>
            {site.contact.instagram}
          </a>
        )}
      </p>
    </div>
  </div>
</Base>
